#include <iostream>
using namespace std;

int main() {

    int arr[6];

    for (int i = 0; i < 6; i++) {
        cin >> arr[i];
    }

    int max1 = arr[0];
    int max2 = arr[0];

    for (int i = 1; i < 6; i++) {

        if (arr[i] > max1) {
            max2 = max1;
            max1 = arr[i];
        }
        else if (arr[i] > max2 && arr[i] != max1) {
            max2 = arr[i];
        }
    }

    cout << max2;

    return 0;
}
