#include <iostream>
using namespace std;

int FindMaxIndex(int arr[]) {
    int maxIndex = 0;

    for (int i = 1; i < 5; i++) {
        if (arr[i] > arr[maxIndex]) {
            maxIndex = i;
        }
    }

    return maxIndex;
}

int main() {
    int arr[5];

    for (int i = 0; i < 5; i++) {
        cin >> arr[i];
    }

    int index = FindMaxIndex(arr);

    cout << "Maximum Value = " << arr[index] << endl;
    cout << "Index = " << index << endl;

    return 0;
}
