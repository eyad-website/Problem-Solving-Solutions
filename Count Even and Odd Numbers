#include <iostream>
using namespace std;

void CountEvenOdd(int arr[]) {
    int evenCount = 0;
    int oddCount = 0;

    for (int i = 0; i < 10; i++) {
        if (arr[i] % 2 == 0)
            evenCount++;
        else
            oddCount++;
    }

    cout << "Even Count = " << evenCount << endl;
    cout << "Odd Count = " << oddCount << endl;
}

int main() {
    int arr[10];

    for (int i = 0; i < 10; i++) {
        cin >> arr[i];
    }

    CountEvenOdd(arr);

    return 0;
}
