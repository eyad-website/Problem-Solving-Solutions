#include <iostream>
using namespace std;

int main() {

    int a[7];

    for (int i = 0; i < 7; i++) {
        cin >> a[i];
    }

    for (int i = 0; i < 7; i++) {

        int count = 0;

        for (int j = 0; j < 7; j++) {

            if (a[i] == a[j]) {
                count++;
            }
        }

        if (count == 1) {
            cout << a[i];
            break;
        }
    }

    return 0;
}
