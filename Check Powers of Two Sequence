#include <iostream>
using namespace std;

int main() {

    int a[5];

    for (int i = 0; i < 5; i++) {
        cin >> a[i];
    }

    bool ok = true;

    for (int i = 1; i < 5; i++) {

        if (a[i] != a[i - 1] * 2) {
            ok = false;
            break;
        }
    }

    if (ok)
        cout << "True";
    else
        cout << "False";

    return 0;
}
