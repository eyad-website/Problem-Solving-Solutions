#include <iostream>
using namespace std;

int main() {

    int arr[6];

    for (int i = 0; i < 6; i++) {
        cin >> arr[i];
    }

    int max = arr[0];
    int min = arr[0];

    for (int i = 1; i < 6; i++) {

        if (arr[i] > max)
            max = arr[i];

        if (arr[i] < min)
            min = arr[i];
    }

    bool repeat = false;

    for (int i = 0; i < 6; i++) {

        for (int j = i + 1; j < 6; j++) {

            if (arr[i] == arr[j]) {
                repeat = true;
                break;
            }
        }

        if (repeat)
            break;
    }

    if (max - min == 5 && !repeat)
        cout << "Yes";
    else
        cout << "No";

    return 0;
}
