#include <iostream>
using namespace std;

int main() {

    int arr[6];

    for (int i = 0; i < 6; i++) {
        cin >> arr[i];
    }

    bool ok = true;

    for (int i = 0; i < 3; i++) {

        if (arr[i] != arr[5 - i]) {
            ok = false;
            break;
        }
    }

    if (ok)
        cout << "YES";
    else
        cout << "NO";

    return 0;
}
