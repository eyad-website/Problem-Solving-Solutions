#include <iostream>
using namespace std;

int main() {

    int arr[5];

    for (int i = 0; i < 5; i++) {
        cin >> arr[i];
    }

    for (int i = 0; i < 5; i++) {

        bool repeat = false;

        for (int j = 0; j < i; j++) {

            if (arr[i] == arr[j]) {
                repeat = true;
                break;
            }
        }

        if (!repeat) {
            cout << arr[i] << " ";
        }
    }

    return 0;
}
