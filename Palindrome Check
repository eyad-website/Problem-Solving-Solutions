#include <iostream>
#include <string>
using namespace std;

int main() {
    string word;
    string reverseWord = "";

    cin >> word;

    for (int i = word.length() - 1; i >= 0; i--) {
        reverseWord += word[i];
    }

    if (word == reverseWord)
        cout << "Yes, Palindrome";
    else
        cout << "No, Not Palindrome";

    return 0;
}
