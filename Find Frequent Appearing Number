#include <iostream>
using namespace std;

int main() {

    int arr[7];

    for (int i = 0; i < 7; i++) {
        cin >> arr[i];
    }

    int FAH = -1;

    for (int i = 0; i < 7; i++) {

        int count = 0;

        for (int j = 0; j < 7; j++) {

            if (arr[i] == arr[j]) {
                count++;
            }
        }

        if (count >= 4) {
            FAH = arr[i];
            break;
        }
    }

    cout << FAH;

    return 0;
}
