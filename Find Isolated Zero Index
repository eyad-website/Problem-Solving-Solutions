#include <iostream>
using namespace std;

int main() {

    int arr[7];

    for (int i = 0; i < 7; i++) {
        cin >> arr[i];
    }

    for (int i = 0; i < 7; i++) {

        if (arr[i] == 0) {

            if (i == 0 && arr[i + 1] == 1) {
                cout << i;
            }

            else if (i == 6 && arr[i - 1] == 1) {
                cout << i;
            }

            else if (i > 0 && i < 6 &&
                     arr[i - 1] == 1 &&
                     arr[i + 1] == 1) {
                cout << i;
            }
        }
    }

    return 0;
}
