#include <iostream>
#include <string>
using namespace std;

int main() {

    string pass;
    bool hasNumber = false;

    cin >> pass;

    if (pass.length() >= 8) {

        for (int i = 0; i < pass.length(); i++) {

            if (pass[i] >= '0' && pass[i] <= '9') {
                hasNumber = true;
                break;
            }
        }
    }

    if (pass.length() >= 8 && hasNumber)
        cout << "Strong";
    else
        cout << "Weak";

    return 0;
}
