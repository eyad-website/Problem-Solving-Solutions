#include <iostream>
using namespace std;

int main() {

    int arr[6];

    for (int i = 0; i < 6; i++) {
        cin >> arr[i];
    }

    int temp;

    for (int i = 0; i < 3; i++) {

        temp = arr[i];
        arr[i] = arr[5 - i];
        arr[5 - i] = temp;
    }

    for (int i = 0; i < 6; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
